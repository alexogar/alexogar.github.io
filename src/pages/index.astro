---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import {
  profile,
  operatingModel,
  impact,
  autobahn,
  platformWork,
  delivery,
  aiWork,
  projects,
  expertise,
  career,
  promotions,
  education,
} from "../data/profile";
---

<Layout>
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-content">
        <p class="eyebrow">Hands-on engineering · {profile.location}</p>
        <h1 id="intro-title">
          Alexey
          <br />
          Ogarkov<span>.</span>
        </h1>
        <p class="hero-role">
          {profile.role}
          <br />
          <span>{profile.focus}</span>
        </p>
        <p class="hero-summary">{profile.summary}</p>
        <div class="hero-actions">
          <a
            class="button button-primary"
            href="/alexey-ogarkov-cv.pdf"
            download
          >
            Download CV <Arrow direction="down" />
          </a>
          <a class="text-link" href="/cv/">
            Read CV <Arrow direction="right" />
          </a>
        </div>
        <div class="social-links">
          <a href={profile.github}>
            GitHub <Arrow />
          </a>
          <a href={profile.linkedin}>
            LinkedIn <Arrow />
          </a>
          <a href={`mailto:${profile.email}`}>
            Email <Arrow />
          </a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Current focus">
        <div class="platform-drawing" aria-hidden="true">
          <svg viewBox="0 0 340 280" fill="none">
            <path
              d="m170 40 124 68-124 69-124-69 124-68Z"
              fill="#e8ede5"
              stroke="#719186"
            />
            <path
              d="m46 153 124 68 124-68M46 198l124 68 124-68"
              stroke="#b3c2b8"
            />
            <path
              d="M46 108v90m124-21v89m124-158v90"
              stroke="#b3c2b8"
              stroke-dasharray="3 5"
            />
            <path
              d="m170 71 70 38-70 39-70-39 70-38Z"
              fill="#d4e2d7"
              stroke="#286456"
            />
            <path d="m170 91 33 18-33 19-33-19 33-18Z" fill="#286456" />
            <circle cx="46" cy="108" r="4" fill="#286456" />
            <circle cx="294" cy="108" r="4" fill="#286456" />
            <circle cx="170" cy="177" r="4" fill="#286456" />
          </svg>
          <span class="drawing-label drawing-label-top">
            A useful foundation
          </span>
          <span class="drawing-label drawing-label-bottom">
            Room for everyone to build
          </span>
        </div>
        <div class="current-focus">
          <p class="meta">Currently at Deutsche Bank</p>
          <p>
            Director · Principal
            <br />
            Software Engineer
          </p>
          <span>Building the Autobahn platform</span>
        </div>
      </aside>
    </section>

    <section class="section section-grid" aria-labelledby="approach-title">
      <p class="section-label">
        <span>01</span> How I work
      </p>
      <div>
        <h2 id="approach-title">
          Solve it once.
          <br />
          Make it useful to many.
        </h2>
        <p class="section-intro">
          My work starts with a real engineering problem and ends with something
          other teams can build on.
        </p>
        <ol class="operating-model">
          {operatingModel.map((step, index) => (
            <li>
              <span class="step-number">0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      class="section section-grid impact-section"
      aria-labelledby="impact-title"
    >
      <p class="section-label">
        <span>02</span> Selected impact
      </p>
      <div>
        <h2 id="impact-title" class="impact-heading">
          The scale behind the work.
        </h2>
        <dl class="impact-grid">
          {impact.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd class="impact-value">{item.value}</dd>
              <dd class="impact-detail">{item.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section
      class="section section-grid"
      id="autobahn"
      aria-labelledby="autobahn-title"
    >
      <p class="section-label">
        <span>03</span> The Autobahn story
      </p>
      <div>
        <p class="meta muted">Deutsche Bank · 2012 — Present</p>
        <h2 id="autobahn-title">
          From a fragile gateway
          <br />
          to a shared platform.
        </h2>
        <div class="story-intro">
          <p>{autobahn.introduction}</p>
          <p>{autobahn.foundation}</p>
        </div>
        <div class="platform-work">
          {platformWork.map((work, index) => (
            <article>
              <div class="work-index">0{index + 1}</div>
              <div>
                <p class="work-tag">{work.tag}</p>
                <h3>{work.title}</h3>
                <p>{work.text}</p>
                <p>{work.detail}</p>
                {"principle" in work && (
                  <p class="principle">{work.principle}</p>
                )}
              </div>
            </article>
          ))}
        </div>
        <aside class="pilot-note" aria-labelledby="delivery-title">
          <p class="meta">GitHub · CI/CD · GitOps</p>
          <h3 id="delivery-title">{delivery.title}</h3>
          <p>{delivery.text}</p>
        </aside>
        <aside class="pilot-note" aria-labelledby="ai-title">
          <p class="meta">Developer tooling · Adoption & exploration</p>
          <h3 id="ai-title">{aiWork.title}</h3>
          <p>{aiWork.text}</p>
          <p>{aiWork.pilot}</p>
        </aside>
      </div>
    </section>

    <section
      class="section section-grid"
      id="work"
      aria-labelledby="work-title"
    >
      <p class="section-label">
        <span>04</span> Selected work
      </p>
      <div>
        <h2 id="work-title">
          Shared foundations.
          <br />
          <em>Personal ownership.</em>
        </h2>
        <div class="project-grid">
          {projects.map((project) => (
            <article class={`project project-${project.id}`}>
              <p class="meta">{project.label}</p>
              <div class="project-symbol" aria-hidden="true">
                {project.id === "plexus" ? (
                  <svg width="92" height="66" viewBox="0 0 92 66" fill="none">
                    <path
                      d="M16 16 46 33l30-17M16 50l30-17 30 17"
                      stroke="currentColor"
                    />
                    <rect
                      x="5"
                      y="5"
                      width="22"
                      height="22"
                      rx="4"
                      fill="var(--paper)"
                      stroke="currentColor"
                    />
                    <rect
                      x="65"
                      y="5"
                      width="22"
                      height="22"
                      rx="4"
                      fill="var(--paper)"
                      stroke="currentColor"
                    />
                    <rect
                      x="5"
                      y="39"
                      width="22"
                      height="22"
                      rx="4"
                      fill="var(--paper)"
                      stroke="currentColor"
                    />
                    <rect
                      x="65"
                      y="39"
                      width="22"
                      height="22"
                      rx="4"
                      fill="var(--paper)"
                      stroke="currentColor"
                    />
                    <circle cx="46" cy="33" r="7" fill="currentColor" />
                  </svg>
                ) : (
                  <span>
                    l<span>✦</span>
                  </span>
                )}
              </div>
              <h3>{project.title}</h3>
              <p class="project-role">{project.role}</p>
              <p>{project.text}</p>
              <p class="project-detail">{project.detail}</p>
              <ul class="tags" aria-label={`${project.title} focus areas`}>
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <a class="text-link" href={project.url}>
                {project.link} <Arrow />
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-grid" aria-labelledby="expertise-title">
      <p class="section-label">
        <span>05</span> Technical expertise
      </p>
      <div>
        <h2 id="expertise-title">A working toolkit.</h2>
        <p class="section-intro">
          The technologies serve the problem. These are the areas I work across.
        </p>
        <dl class="expertise">
          {expertise.map((group) => (
            <div>
              <dt>{group.title}</dt>
              <dd>
                {group.items.map((item, index) => (
                  <Fragment>
                    {index > 0 && (
                      <span class="separator" aria-hidden="true">
                        {" "}
                        /{" "}
                      </span>
                    )}
                    <span>{item}</span>
                  </Fragment>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section
      class="section section-grid"
      id="experience"
      aria-labelledby="experience-title"
    >
      <p class="section-label">
        <span>06</span> Career
      </p>
      <div>
        <h2 id="experience-title">A career close to the code.</h2>
        <div class="career">
          {career.map((job, index) => (
            <article>
              <p class="career-date">{job.dates}</p>
              <h3>{job.company}</h3>
              <p class="career-role">{job.role}</p>
              <p>{job.text}</p>
              {index === 0 && (
                <>
                  <p>{autobahn.scope}</p>
                  <dl class="promotions">
                    {promotions.map((promotion) => (
                      <div>
                        <dt>{promotion.role}</dt>
                        <dd>{promotion.dates}</dd>
                      </div>
                    ))}
                  </dl>
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="section section-grid education"
      aria-labelledby="education-title"
    >
      <p class="section-label">
        <span>07</span> Education
      </p>
      <div>
        <p class="career-date">{education.dates}</p>
        <h2 id="education-title">{education.school}</h2>
        <p>
          {education.subject}
          <br />
          <span class="muted">{education.faculty}</span>
        </p>
      </div>
    </section>

    <section
      class="section section-grid contact"
      id="contact"
      aria-labelledby="contact-title"
    >
      <p class="section-label">
        <span>08</span> Contact
      </p>
      <div>
        <p class="eyebrow">{profile.location}</p>
        <h2 id="contact-title">
          Good platforms start
          <br />
          with a conversation.
        </h2>
        <p class="section-intro">
          Let’s talk about engineering problems worth solving, and the teams
          building what comes next.
        </p>
        <a class="contact-email" href={`mailto:${profile.email}`}>
          {profile.email} <Arrow />
        </a>
        <div class="social-links">
          <a href={profile.github}>
            GitHub <Arrow />
          </a>
          <a href={profile.linkedin}>
            LinkedIn <Arrow />
          </a>
          <a href="/cv/">
            Read CV <Arrow direction="right" />
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 50px;
    padding-block: 70px 78px;
  }
  .hero h1 {
    font-size: clamp(5.5rem, 9.8vw, 8.6rem);
    letter-spacing: -0.065em;
    line-height: 0.89;
    margin-block: 36px 32px;
  }
  .hero h1 > span {
    color: var(--accent);
  }
  .hero-role {
    font-size: 1.35rem;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  .hero-role span {
    color: var(--muted);
  }
  .hero-summary {
    max-width: 460px;
    color: var(--muted);
    font-size: 1.05rem;
    margin-block: 1.6rem 1.8rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    flex-wrap: wrap;
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-top: 1.8rem;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    text-decoration: none;
    padding-block: 0.3rem;
  }
  .social-links svg {
    width: 13px;
    height: 13px;
  }
  .hero-aside {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .platform-drawing {
    width: 100%;
    max-width: 370px;
    position: relative;
    padding: 2rem 0;
  }
  .platform-drawing svg {
    width: 100%;
    height: auto;
  }
  .drawing-label {
    position: absolute;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .drawing-label-top {
    top: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .drawing-label-bottom {
    bottom: 0.5rem;
    right: 0;
  }
  .current-focus {
    align-self: stretch;
    margin: 2.5rem 1rem 0 3rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .current-focus > p:nth-child(2) {
    font: 1.45rem/1.25 var(--serif);
    margin-bottom: 0.65rem;
  }
  .current-focus > span {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .current-focus .meta {
    font-size: 0.62rem;
    color: var(--muted);
  }
  .operating-model {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    list-style: none;
    padding: 0;
    margin-bottom: 0;
  }
  .step-number {
    font: 1rem var(--serif);
    color: var(--accent);
    display: block;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    margin-bottom: 1rem;
  }
  .operating-model h3 {
    font-size: 1rem;
    font-weight: 550;
  }
  .operating-model p {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }
  .impact-heading {
    font-size: 2.25rem;
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-block: 2.5rem 0;
  }
  .impact-grid > div {
    display: flex;
    flex-direction: column;
  }
  .impact-grid dt {
    font-size: 0.78rem;
    font-weight: 550;
    order: 2;
  }
  .impact-grid dd {
    margin: 0;
  }
  .impact-value {
    font: 3.7rem/1 var(--serif);
    letter-spacing: -0.05em;
    color: var(--accent);
    order: 1;
    padding-bottom: 0.65rem;
  }
  .impact-detail {
    font-size: 0.73rem;
    color: var(--muted);
    order: 3;
    padding-top: 0.5rem;
  }
  .muted {
    color: var(--muted);
  }
  .story-intro {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 730px;
    margin-bottom: 3rem;
  }
  .platform-work article {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 24px;
    border-top: 1px solid var(--line);
    padding-block: 30px;
  }
  .work-index {
    color: var(--accent);
    font: 1rem var(--serif);
    padding-top: 4px;
  }
  .work-tag {
    color: var(--muted);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
  }
  .platform-work h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .platform-work article p:not(.work-tag) {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .platform-work article p:last-child {
    margin-bottom: 0;
  }
  .principle {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }
  .pilot-note {
    background: var(--tint);
    padding: 28px 32px;
    margin-top: 0.5rem;
  }
  .pilot-note .meta {
    font-size: 0.64rem;
    color: var(--accent);
  }
  .pilot-note p:not(.meta) {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .pilot-note p:last-child {
    margin-bottom: 0;
  }
  em {
    color: var(--accent);
  }
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 2.5rem;
  }
  .project {
    padding: 30px;
    border: 1px solid var(--line);
    background: #f0f2ec;
    display: flex;
    flex-direction: column;
  }
  .project-lorely {
    background: #f0ece5;
  }
  .project .meta {
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    color: var(--muted);
  }
  .project-symbol {
    margin-block: 2rem;
    min-height: 66px;
    color: var(--accent);
    display: flex;
    align-items: center;
  }
  .project-lorely .project-symbol {
    color: #695642;
  }
  .project-symbol > span {
    font: italic 4.8rem/0.8 var(--serif);
  }
  .project-symbol > span > span {
    font-size: 2rem;
    padding-left: 0.2rem;
    vertical-align: top;
  }
  .project h3 {
    font: 2.6rem var(--serif);
    letter-spacing: -0.04em;
    margin-bottom: 0.25rem;
  }
  .project-role {
    font-size: 0.75rem !important;
    color: var(--accent) !important;
    margin-bottom: 1.5rem;
  }
  .project > p:not(.meta) {
    font-size: 0.88rem;
  }
  .project-detail {
    color: var(--muted);
    font-size: 0.78rem !important;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin-block: auto 1.5rem;
    padding-top: 0.8rem;
  }
  .tags li {
    font-size: 0.62rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid #d1d6cc;
    border-radius: 3px;
  }
  .project .text-link {
    font-size: 0.78rem;
    justify-content: space-between;
  }
  .expertise {
    margin: 0;
  }
  .expertise > div {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .expertise dt {
    font-size: 0.85rem;
    font-weight: 550;
  }
  .expertise dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .separator {
    color: #89948b;
    padding-inline: 0.25rem;
  }
  .career article {
    position: relative;
    padding-block: 30px;
    border-top: 1px solid var(--line);
  }
  .career h3 {
    font: 2rem var(--serif);
    margin-bottom: 0.5rem;
  }
  .career-date {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .career-role {
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .career article > p:not(.career-date, .career-role),
  .career ul {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .career ul {
    padding-left: 1.1rem;
    margin-bottom: 0;
  }
  .career li + li {
    margin-top: 0.4rem;
  }
  .promotions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-block: 1.5rem 0;
    padding-top: 1rem;
  }
  .promotions dt {
    font-size: 0.73rem;
  }
  .promotions dd {
    font-size: 0.67rem;
    color: var(--muted);
    margin: 0.2rem 0 0;
  }
  .education h2 {
    font-size: 2.2rem;
  }
  .education p:last-child {
    font-size: 0.9rem;
    margin: 0;
  }
  .contact {
    padding-block: 90px 100px;
  }
  .contact-email {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    font-size: clamp(1rem, 2.3vw, 1.5rem);
    letter-spacing: -0.025em;
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 24px;
    }
    .impact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .expertise > div {
      grid-template-columns: 160px 1fr;
    }
    .project {
      padding: 24px;
    }
    .project-grid {
      gap: 16px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 48px 58px;
    }
    .hero h1 {
      font-size: clamp(5.5rem, 18vw, 8.5rem);
    }
    .hero-aside {
      display: none;
    }
    .operating-model {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .step-number {
      margin-bottom: 0.6rem;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
    .expertise > div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .promotions {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .promotions > div {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }
  }
  @media (max-width: 640px) {
    .hero .eyebrow {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }
    .hero-role {
      font-size: 1.15rem;
    }
    .hero-summary {
      font-size: 1rem;
    }
    .impact-value {
      font-size: 3.5rem;
    }
    .impact-grid {
      column-gap: 20px;
    }
    .platform-work article {
      grid-template-columns: 22px 1fr;
      gap: 12px;
    }
    .pilot-note {
      padding: 24px;
    }
    .contact {
      padding-block: 58px 68px;
    }
  }
</style>
