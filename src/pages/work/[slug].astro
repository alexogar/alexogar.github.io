---
import Layout from "../../layouts/Layout.astro";
import Arrow from "../../components/Arrow.astro";
import { caseStudies, type CaseStudy } from "../../data/caseStudies";

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props as { study: CaseStudy };
---

<Layout
  title={study.title + " — Alexey Ogarkov"}
  description={study.description}
>
  <article class="shell case-study">
    <nav class="case-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Alexey Ogarkov</a>
      <span aria-hidden="true">/</span>
      <a href="/#work">Selected work</a>
    </nav>

    <header class="case-hero">
      <p class="eyebrow">{study.category}</p>
      <h1>{study.title}</h1>
      <p class="case-lead">{study.overview}</p>
      <p class="case-role">
        <strong>My role</strong> {study.role}
      </p>
    </header>

    <div class="case-body">
      <section aria-labelledby="challenge-heading">
        <p class="case-kicker">01 / Context</p>
        <h2 id="challenge-heading">The challenge</h2>
        <p>{study.context}</p>
      </section>

      <section aria-labelledby="contribution-heading">
        <p class="case-kicker">02 / Contribution</p>
        <h2 id="contribution-heading">What I did</h2>
        <ul>
          {study.contribution.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="outcomes-heading">
        <p class="case-kicker">03 / Outcomes</p>
        <h2 id="outcomes-heading">What it enabled</h2>
        <ul>
          {study.outcomes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="takeaway-heading">
        <p class="case-kicker">04 / Takeaway</p>
        <h2 id="takeaway-heading">What I learned</h2>
        <p>{study.reflection}</p>
      </section>
    </div>

    <footer class="case-footer">
      {study.external && (
        <a class="button button-primary" href={study.external.url}>
          {study.external.label} <Arrow direction="right" />
        </a>
      )}
      <a class="text-link" href="/#work">
        Back to selected work <Arrow direction="right" />
      </a>
    </footer>
  </article>
</Layout>

<style>
  .case-study {
    padding-bottom: 7rem;
    max-width: 1040px;
  }
  .case-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    padding-block: 2rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .case-breadcrumbs a {
    text-decoration: underline;
  }
  .case-hero {
    padding-block: 3rem 5rem;
    border-bottom: 1px solid var(--line);
  }
  .case-hero h1 {
    max-width: 950px;
    font-size: clamp(3rem, 7vw, 5.7rem);
    letter-spacing: -0.05em;
    margin-block: 2rem;
  }
  .case-lead {
    max-width: 740px;
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
  }
  .case-role {
    max-width: 760px;
    margin-top: 2rem;
    color: var(--muted);
  }
  .case-role strong {
    color: var(--ink);
    margin-right: 0.5rem;
  }
  .case-body {
    display: grid;
    gap: 0;
  }
  .case-body section {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1.2rem 3rem;
    padding-block: 3.5rem;
    border-bottom: 1px solid var(--line);
  }
  .case-kicker {
    grid-row: 1 / 3;
    color: var(--accent);
    font-size: 0.76rem;
    margin-top: 0.55rem;
  }
  .case-body h2 {
    font-size: clamp(1.9rem, 3vw, 2.65rem);
    margin: 0;
  }
  .case-body h2 + p,
  .case-body ul {
    grid-column: 2;
    max-width: 720px;
    color: var(--muted);
    margin-bottom: 0;
  }
  .case-body ul {
    padding-left: 1.3rem;
  }
  .case-body li + li {
    margin-top: 0.9rem;
  }
  .case-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    padding-top: 2.6rem;
  }
  @media (max-width: 640px) {
    .case-study {
      padding-bottom: 4rem;
    }
    .case-hero {
      padding-block: 2rem 3rem;
    }
    .case-body section {
      display: block;
      padding-block: 2.5rem;
    }
    .case-kicker {
      margin-bottom: 0.8rem;
    }
    .case-body h2 {
      margin-bottom: 1.5rem;
    }
    .case-footer {
      align-items: stretch;
    }
  }
</style>
