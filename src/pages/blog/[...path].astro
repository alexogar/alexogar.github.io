---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const categories = [
    ...new Set(posts.flatMap((post) => post.data.categories)),
  ];
  return [
    ...posts.map((post) => ({
      params: { path: post.data.path },
      props: { postId: post.id },
    })),
    { params: { path: undefined }, props: {} },
    { params: { path: "archives" }, props: {} },
    { params: { path: "categories" }, props: { categoryIndex: true } },
    ...categories.map((category) => ({
      params: { path: `categories/${category}` },
      props: { category },
    })),
  ];
}
interface Props {
  postId?: string;
  category?: string;
  categoryIndex?: boolean;
}
const { postId, category, categoryIndex } = Astro.props;
const posts = (await getCollection("blog")).sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
const post = posts.find((entry) => entry.id === postId);
const Content = post ? (await render(post)).Content : undefined;
const categories = [
  ...new Set(posts.flatMap((entry) => entry.data.categories)),
].sort();
const title =
  post?.data.title ??
  (categoryIndex
    ? "Writing by topic"
    : category
      ? `Writing about ${category}`
      : "Archived writing");
const dateLabel = (date: string) =>
  new Date(date.slice(0, 10)).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---

<Layout
  title={`${title} — Alexey Ogarkov`}
  description={
    post?.data.description ??
    "Historical engineering notes from 2013, preserved from Alexey Ogarkov’s original Octopress blog."
  }
  article={!!post}
>
  <div class="shell">
    <header class="archive-head">
      <p class="eyebrow">
        The archive · {post ? dateLabel(post.data.date) : "2013"}
      </p>
      <h1>{title}</h1>
      <p class="archive-note">
        These notes are preserved from my original blog. They reflect the tools
        and opinions of 2013 and may no longer describe current practice.
      </p>
    </header>
    {post && Content ? (
      <article class="prose article-body">
        <Content />
        <nav class="category-links" aria-label="Article topics">
          {post.data.categories.map((topic) => (
            <a href={`/blog/categories/${topic}/`}>{topic}</a>
          ))}
          <a href="/blog/archives/">All archived writing</a>
        </nav>
      </article>
    ) : (
      <>
        {categoryIndex ? (
          <ul class="archive-list">
            {categories.map((topic) => (
              <li>
                <h2>
                  <a href={`/blog/categories/${topic}/`}>{topic}</a>
                </h2>
                <p>
                  {
                    posts.filter((entry) =>
                      entry.data.categories.includes(topic),
                    ).length
                  }{" "}
                  article
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="archive-list">
            {posts
              .filter(
                (entry) =>
                  !category || entry.data.categories.includes(category),
              )
              .map((entry) => (
                <li>
                  <time datetime={entry.data.date}>
                    {dateLabel(entry.data.date)}
                  </time>
                  <div>
                    <h2>
                      <a href={`/blog/${entry.data.path}/`}>
                        {entry.data.title}
                      </a>
                    </h2>
                    <p>{entry.data.description}</p>
                  </div>
                </li>
              ))}
          </ul>
        )}
        <nav class="category-links" aria-label="Archive navigation">
          <a href="/blog/archives/">All writing</a>
          <a href="/blog/categories/">Browse topics</a>
          <a
            href={
              category ? `/blog/categories/${category}/atom.xml` : "/atom.xml"
            }
          >
            Atom feed
          </a>
        </nav>
      </>
    )}
  </div>
</Layout>
