---
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-400-italic.css";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";
import { profile, expertise, education } from "../data/profile";
import Arrow from "../components/Arrow.astro";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title = `${profile.name} — ${profile.role} · ${profile.focus}`,
  description = "Hands-on Principal Software Engineer in Berlin. Frontend and developer platforms, microfrontends, design systems and connected application experiences at Deutsche Bank.",
  article = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": new URL("/#alexey", Astro.site).href,
  name: profile.name,
  url: Astro.site?.href,
  jobTitle: profile.role,
  description: profile.cvSummary,
  email: `mailto:${profile.email}`,
  worksFor: { "@type": "Organization", name: "Deutsche Bank" },
  homeLocation: { "@type": "Place", name: profile.location },
  alumniOf: { "@type": "CollegeOrUniversity", name: education.school },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: expertise.flatMap((group) => group.items),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f7f6f2" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/social-preview.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Alexey Ogarkov — Principal Software Engineer, Frontend & Developer Platforms"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/social-preview.png", Astro.site)}
    />
    <meta
      name="twitter:image:alt"
      content="Alexey Ogarkov — Principal Software Engineer, Frontend & Developer Platforms"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      href="/atom.xml"
      type="application/atom+xml"
      title="Alexey Ogarkov — archived writing"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(person).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Alexey Ogarkov — home">
        <span class="monogram" aria-hidden="true">
          ao<span>.</span>
        </span>
        <span class="wordmark-name">Alexey Ogarkov</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
        <a class="nav-cv" href="/cv/">
          CV <Arrow direction="right" />
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <p>© {new Date().getFullYear()} Alexey Ogarkov</p>
      <div>
        <span>Built with care. Kept simple.</span>
        <a href="/blog/archives/">
          Archived writing <Arrow direction="right" />
        </a>
      </div>
    </footer>
  </body>
</html>
